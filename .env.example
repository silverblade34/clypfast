# API Keys — LLM Providers

# Groq (default) — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini (alternativa) — https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_api_key_here

# Opcional: sesión de YouTube para descargas bloqueadas. Activa solo una opción.
# Lee cookies del navegador elegido; inicia sesión en YouTube antes de exportar.
# CLIPFINDER_YOUTUBE_COOKIES_BROWSER=brave
# Alternativa: archivo de cookies en formato Netscape.
# CLIPFINDER_YOUTUBE_COOKIES_FILE=/ruta/privada/youtube-cookies.txt
